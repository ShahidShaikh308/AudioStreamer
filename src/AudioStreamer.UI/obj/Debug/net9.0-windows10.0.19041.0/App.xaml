<Application
    x:Class="AudioStreamer.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AccentBrush" Color="#7266F5" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#267266F5" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{ThemeResource CardStrokeColorDefault}" />
            <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
            <Style x:Key="AudioCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="AudioButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="MinHeight" Value="38" />
            </Style>
            <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AudioButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="MinHeight" Value="38" />
            </Style>
            <DataTemplate x:Key="PeerCardTemplate">
                <Border Style="{StaticResource AudioCardStyle}" Width="264" Height="184" Margin="6">
                    <StackPanel Spacing="9">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource AccentSoftBrush}">
                                <FontIcon Glyph="&#xE77B;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="2" Padding="7,3" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontSize="11" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Platform}" Opacity="0.72" />
                        <TextBlock Text="{Binding Address}" FontSize="12" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ProtocolVersion}" FontSize="12" Opacity="0.62" />
                        <TextBlock Text="Select to view details" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
            <ItemsPanelTemplate x:Key="PeerItemsPanel">
                <ItemsWrapGrid Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

