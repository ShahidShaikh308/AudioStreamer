<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AudioStreamer.ico</ApplicationIcon>
    <AssemblyName>AudioStreamer.UI</AssemblyName>
    <RootNamespace>AudioStreamer.UI</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <ProjectReference Include="..\AudioStreamer.UI.Core\AudioStreamer.UI.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\audiostreamer_logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AudioStreamer.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
